#!/bin/zsh
set -eu

if [ ! -d /Applications/ExpressVPN.app ]; then
  echo "ExpressVPN is not installed in /Applications."
  exit 2
fi

if [ ! -f /Library/LaunchDaemons/com.express.vpn.daemon.plist ]; then
  echo "ExpressVPN daemon plist is missing."
  exit 3
fi

/bin/launchctl enable system/com.express.vpn.daemon 2>/dev/null || true
/bin/launchctl enable system/com.expressvpn.expressvpnd 2>/dev/null || true
/bin/launchctl bootstrap system /Library/LaunchDaemons/com.express.vpn.daemon.plist 2>/dev/null || \
  /bin/launchctl kickstart -k system/com.express.vpn.daemon 2>/dev/null || true

